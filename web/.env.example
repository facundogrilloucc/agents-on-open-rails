# Copiar a .env.local (está en .gitignore) y completar. Nunca commitear ni pegar en chats.

# Clave privada de la wallet del agente (0x477f…2159). Solo la usan los scripts del servidor.
AGENT_PRIVATE_KEY=

# Código de atribución que da la inscripción en la hackatón. Derivado del repo debería ser
# celo_976812496a25: confirmarlo con el que muestre la plataforma al inscribirse.
ATTRIBUTION_CODE=celo_976812496a25
# Repo de GitHub con el que se inscribieron. Se usa para validar el código.
GITHUB_REPO=facundogrilloucc/agents-on-open-rails

# Opcional: URL HTTPS del archivo de registro ERC-8004. Si se deja vacío, se usa un data: URI
# con el contenido de public/agent-registration.json.
AGENT_URI=
