# Copiar a .env.local (está en .gitignore) y completar. Nunca commitear ni pegar en chats.

# Clave privada de la wallet del agente (0x477f…2159). Solo la usan los scripts del servidor.
AGENT_PRIVATE_KEY=

# Código de atribución de la ENTRADA del equipo en Loops House (Playground → botón "Celo" arriba).
# Lo asigna la plataforma por entrada: NO se deriva del repo. Copiarlo de ahí, confirmado por el equipo.
ATTRIBUTION_CODE=
# Opcional: si se completa, el script verifica que el código coincida con codeFromRepo(GITHUB_REPO).
# Dejar vacío: el código de Loops House no sale del repo.
GITHUB_REPO=

# Opcional: URL HTTPS del archivo de registro ERC-8004. Si se deja vacío, se usa un data: URI
# con el contenido de public/agent-registration.json.
AGENT_URI=
